	collaborator = {Adams, Cosima and Bochert, Anton and Gerike, Martin and Kuhrmeier, Josefine and Müller, Anna-Tabea and Nissen, Eric and Siegers, Rainer and Steinhauer, Hans Walter and Wenzig, Knut and Witton, Julia and {Infas}},
	year = {2024},
	keywords = {10000 Social Sciences, 10200 Sociology, 10500 Political Science, 10706 Social Psychology, 10900 Economics, attitude, Cleavage, coexistence, conflict, fragmentation, inequality, KAT50 Society, Culture, KAT51 Community, Living Environment, Living together, polarization, Political conflict, social cohesion, Social conflict, Social group, social network, Society, socioeconomic position, Trajectory},
